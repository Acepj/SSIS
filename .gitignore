# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
coverage/
*.local

# Environment files (keep examples only)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
npm-error.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Backend runtime artifacts (created by tools, not source)
backend/vendor/

# JSON data files are committed as sample data; runtime artifacts are not.
backend/storage/data/*.lock
backend/storage/data/*.bak
backend/storage/data/*.tmp
backend/storage/data/.*

backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/storage/backups/*
!backend/storage/backups/.gitkeep
backend/.env

# Test caches
.phpunit.result.cache
.phpunit.cache/

# Composer (dev tooling; vendor/ is already ignored)
backend/composer.phar

