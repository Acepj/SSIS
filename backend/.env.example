# SSIS backend environment (copy to .env and adjust). PLACEHOLDERS ONLY -
# never commit real secrets. .env is git-ignored.

# local | testing | production
APP_ENV=local
# Must be false in production; only affects log verbosity, never API responses.
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

# Session cookie name/lifetime (seconds). 7 days by default.
SESSION_NAME=ssis_session
SESSION_LIFETIME=604800

# Comma-separated list of allowed frontend origins (no wildcards).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login rate limiting: attempts per window (seconds), per IP + identifier.
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW=900

# Current academic period displayed across the application.
ACADEMIC_YEAR=2026-2027
ACADEMIC_SEMESTER=First Semester

# Optional: isolated storage root (used by tests). Defaults to backend/storage.
# SSIS_STORAGE_PATH=
