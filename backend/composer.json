{
  "name": "ssis/backend",
  "description": "SSIS Student Services Information System - plain PHP REST API with JSON file storage",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "SSIS\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SSIS\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
