# Base URL for the PHP REST API. In development Vite proxies /api/* to the
# PHP server (see vite.config.ts), so the default works without CORS.
# Never put secrets here - frontend env vars are public.
VITE_API_BASE_URL=/api/v1

# Dev-only override for the Vite proxy target. Needed when the PHP server
# binds to IPv6 localhost (ECONNREFUSED on 127.0.0.1) - copy to .env:
# VITE_PROXY_TARGET=http://localhost:8000

